{
  "compilerOptions": {
    "module": "CommonJS",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "target": "ES2020",
    "outDir": "./lib",
    "rootDir": "./",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true
  },
  "include": [
    "*.ts"
  ],
  "exclude": [
    "lib",
    "node_modules"
  ]
}

